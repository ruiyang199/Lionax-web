---
import SiteLayout from '../layouts/SiteLayout.astro';

const categories = [
	['润滑油', '汽车 / Powersports', '全系列荷兰原罐原装，覆盖汽车与动力运动用油。'],
	['汽美产品', '清洁 / 漆面护理', '面向洗车、美容和外观护理。'],
	['养护品', '冷却 / 添加剂', '覆盖日常保养与功能维护。'],
	['维修耗材', '快保 / 门店常备', '适配汽修、快保和补货场景。'],
];

const strengths = [
	['荷兰原罐原装', '力耐润滑油全系列从荷兰原罐原装，以稳定供应服务中国车主和门店渠道。'],
	['全线覆盖', '从发动机润滑到汽美养护，再到维修耗材形成产品组合。'],
	['渠道友好', '适合经销、电商、汽修快保和终端陈列多种销售方式。'],
];

const heroSlides = [
	{
		title: '润滑油系列',
		desc: 'Engine oil series banner',
		image: '/images/lionax-carousel-oil.png',
	},
	{
		title: 'Powersports',
		desc: 'Motorcycle, motocross and watercraft banner',
		image: '/images/lionax-carousel-powersports.png',
	},
	{
		title: '汽美产品',
		desc: '清洁、护理与美容产品展示',
		image: '/images/lionax-carousel-beauty.png',
	},
	{
		title: '养护耗材',
		desc: '汽车养护与耗材系列 banner',
		image: '/images/lionax-carousel-care.png',
	},
];

const placeholders = [
	{
		title: '门店陈列',
		desc: '品牌形象进店上墙，产品整齐陈列，让终端门店更有识别度。',
		image: '/images/lionax-store-display.jpg',
		alt: 'lionax 门店陈列照片',
	},
	{
		title: '施工场景',
		desc: '从开瓶到加注，每一次标准施工，都是对车辆表现的认真守护。',
		image: '/images/lionax-service-scene.jpg',
		alt: 'lionax 换油施工场景照片',
	},
	{
		title: '赛事赞助',
		desc: '走进真实赛场，以高强度赛事场景验证产品表现，持续强化 LIONAX 动力运动品牌声量。',
		image: '/images/lionax-racing-sponsorship.jpg',
		alt: 'lionax 赛事赞助现场照片',
	},
];
---

<SiteLayout current="home">
	<section class="relative aspect-[2048/768] max-h-[560px] w-full overflow-hidden bg-neutral-950 text-white" aria-label="首页轮播图">
		<div class="absolute inset-0" data-hero-carousel>
			{heroSlides.map((slide, index) => (
				<div
					class:list={[
						'absolute inset-0 flex items-center justify-center px-5 text-center transition-opacity duration-700 sm:px-8',
						index === 0 ? 'opacity-100' : 'opacity-0',
					]}
					data-hero-slide
					aria-hidden={index === 0 ? 'false' : 'true'}
				>
					{slide.image ? (
						<img
							src={slide.image}
							alt={slide.desc}
							class="absolute inset-0 h-full w-full object-contain"
							width="2048"
							height="768"
						/>
					) : (
						<>
							<div class="absolute inset-0 bg-[linear-gradient(115deg,#09090b_0%,#18181b_48%,#e30613_48%,#e30613_100%)]"></div>
							<div class="relative flex h-[72%] w-full max-w-6xl items-center justify-center border border-white/15 bg-white/[0.06]">
								<div class="absolute inset-3 border border-dashed border-white/20 sm:inset-5"></div>
								<div>
									<p class="text-xs font-black uppercase tracking-normal text-white/60 sm:text-sm">Placeholder Image</p>
									<h1 class="mt-2 text-3xl font-black tracking-normal sm:mt-4 sm:text-5xl lg:text-6xl">{slide.title}</h1>
									<p class="mt-2 text-sm font-semibold text-white/75 sm:mt-4 sm:text-lg">{slide.desc}</p>
								</div>
							</div>
						</>
					)}
				</div>
			))}
		</div>
		<div class="absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-2 sm:bottom-6" aria-label="轮播分页">
			{heroSlides.map((_, index) => (
				<button
					type="button"
					class:list={[
						'h-2 w-6 transition sm:h-2.5 sm:w-8',
						index === 0 ? 'bg-white' : 'bg-white/35 hover:bg-white/70',
					]}
					data-hero-dot
					aria-label={`切换到第 ${index + 1} 张`}
					aria-current={index === 0 ? 'true' : 'false'}
				></button>
			))}
		</div>
	</section>

	<section class="bg-white py-12">
		<div class="mx-auto grid max-w-7xl gap-px bg-neutral-200 px-5 sm:px-8 lg:grid-cols-4">
			{categories.map(([title, meta, desc]) => (
				<a href="/products/" class="group bg-white p-6 transition hover:bg-[#e30613]">
					<p class="text-sm font-black uppercase text-[#e30613] transition group-hover:text-neutral-950">{meta}</p>
					<h2 class="mt-3 text-2xl font-black text-neutral-950 transition group-hover:text-white">{title}</h2>
					<p class="mt-3 leading-7 text-neutral-600 transition group-hover:text-white">{desc}</p>
				</a>
			))}
		</div>
	</section>

	<section class="bg-neutral-100 py-20 sm:py-24">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">Product System</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">
					以荷兰进口润滑油带动产品矩阵
				</h2>
				<p class="mt-5 text-lg leading-8 text-neutral-600">
					为更好表现，LIONAX 以全系列荷兰原罐原装润滑油作为核心产品线，并覆盖汽美产品、养护品与维修耗材，围绕保养、清洁、养护和维修补货形成完整产品矩阵，为汽修门店、经销渠道和车主日常养护提供可组合的渠道货架。
				</p>
				<a
					href="/products/"
					class="mt-8 inline-flex min-h-12 items-center justify-center bg-[#e30613] px-6 text-base font-black text-white transition hover:bg-[#c9000b]"
				>
					进入产品中心
				</a>
			</div>
			<div class="overflow-hidden bg-white p-6 shadow-sm">
				<img
					src="/images/lionax-family-hero.png"
					alt="lionax 产品组合"
					class="mx-auto max-h-[380px] w-full scale-[2] object-contain"
					width="1055"
					height="1491"
				/>
			</div>
		</div>
	</section>

	<section class="bg-white pb-8 pt-16 sm:pb-10 sm:pt-20">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mb-8 max-w-3xl">
				<p class="text-sm font-black uppercase text-[#e30613]">Made in Netherlands</p>
				<h2 class="mt-3 text-3xl font-black tracking-normal text-neutral-950 sm:text-4xl">
					润滑油全系列荷兰原罐原装
				</h2>
				<p class="mt-4 text-lg leading-8 text-neutral-600">
					以欧洲标准和原罐原装体系支撑核心润滑油产品，为渠道和终端车主提供稳定、可信的产品基础。
				</p>
			</div>
			<img
				src="/images/lionax-carousel-netherlands.png"
				alt="lionax 荷兰原罐原装说明图"
				class="w-full object-contain"
				width="2048"
				height="768"
			/>
		</div>
	</section>

	<script>
		const carousel = document.querySelector('[data-hero-carousel]');
		const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
		const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
		let activeSlide = 0;
		let slideTimer;

		function showSlide(nextIndex) {
			activeSlide = (nextIndex + slides.length) % slides.length;

			slides.forEach((slide, index) => {
				const isActive = index === activeSlide;
				slide.classList.toggle('opacity-100', isActive);
				slide.classList.toggle('opacity-0', !isActive);
				slide.setAttribute('aria-hidden', String(!isActive));
			});

			dots.forEach((dot, index) => {
				const isActive = index === activeSlide;
				dot.classList.toggle('bg-white', isActive);
				dot.classList.toggle('bg-white/35', !isActive);
				dot.setAttribute('aria-current', String(isActive));
			});
		}

		function startSlides() {
			window.clearInterval(slideTimer);
			slideTimer = window.setInterval(() => showSlide(activeSlide + 1), 4200);
		}

		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				showSlide(index);
				startSlides();
			});
		});

		if (carousel && slides.length > 1) {
			startSlides();
		}
	</script>

	<section class="bg-white pb-20 pt-8 sm:pb-24 sm:pt-10">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="max-w-3xl">
				<p class="text-sm font-black uppercase text-[#e30613]">Why lionax</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">
					从产品到渠道的品牌能力
				</h2>
			</div>
			<div class="mt-10 grid gap-5 lg:grid-cols-3">
				{strengths.map(([title, desc]) => (
					<div class="border border-neutral-200 bg-white p-7 shadow-sm">
						<div class="mb-8 h-1.5 w-16 bg-[#e30613]"></div>
						<h3 class="text-2xl font-black text-neutral-950">{title}</h3>
						<p class="mt-4 leading-7 text-neutral-600">{desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-neutral-950 py-20 text-white sm:py-24">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr]">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">Service & Display</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal sm:text-5xl">终端场景与服务支持</h2>
				<p class="mt-5 text-lg leading-8 text-neutral-300">
					从门店陈列到现场施工，LIONAX 将产品力、品牌形象和终端服务连接起来，让每一次养护都有清晰可见的专业感。
				</p>
			</div>
			<div class="grid gap-4 sm:grid-cols-3">
				{placeholders.map((item) => (
					<div class="border border-white/10 bg-white/[0.06] p-5">
						<div class:list={[
							'flex aspect-square items-center justify-center overflow-hidden border border-dashed border-white/20 bg-white/[0.04] text-xs font-black uppercase text-white/35',
							item.image && 'border-solid',
						]}>
							{item.image ? (
								<img
									src={item.image}
									alt={item.alt}
									class="h-full w-full object-cover"
									width="1080"
									height="1440"
								/>
							) : (
								'Placeholder'
							)}
						</div>
						<h3 class="mt-5 text-xl font-black">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-neutral-300">{item.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-[#e30613] py-14 text-white">
		<div class="mx-auto flex max-w-7xl flex-col justify-between gap-6 px-5 sm:px-8 lg:flex-row lg:items-center">
			<div>
				<p class="text-sm font-black uppercase text-white/75">Cooperation</p>
				<h2 class="mt-2 text-3xl font-black tracking-normal sm:text-4xl">建立 LIONAX 产品渠道合作</h2>
			</div>
			<a
				href="/cooperation/"
				class="inline-flex min-h-12 items-center justify-center bg-white px-6 text-base font-black text-[#e30613] transition hover:bg-neutral-100"
			>
				查看合作方式
			</a>
		</div>
	</section>
</SiteLayout>
