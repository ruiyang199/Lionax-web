---
import SiteLayout from '../layouts/SiteLayout.astro';

const categories = [
	['润滑油', '动力板 / 摩托车 / 汽车', '全系列荷兰原罐原装，覆盖动力板、摩托车与汽车用油。'],
	['汽美产品', '清洁 / 漆面护理', '面向洗车、美容和外观护理。'],
	['养护品', '冷却 / 添加剂', '覆盖日常保养与功能维护。'],
	['维修耗材', '快保 / 维修辅料', '适配汽修、快保和补货场景。'],
];

const heroSlides = [
	{
		title: '释放激情',
		desc: 'LIONAX 动力板用油 banner',
		image: '/images/lionax-home-banner-1.png',
	},
	{
		title: '为速度而生',
		desc: 'LIONAX 摩托车润滑油 banner',
		image: '/images/lionax-home-banner-2.png',
	},
	{
		title: '洁净，顺爽',
		desc: 'LIONAX 汽车润滑油系列 banner',
		image: '/images/lionax-home-banner-3.png',
	},
	{
		title: '汽美产品',
		desc: 'LIONAX 汽美产品系列 banner',
		image: '/images/lionax-home-banner-4.png',
	},
	{
		title: '维修耗材',
		desc: 'LIONAX 维修耗材系列 banner',
		image: '/images/lionax-home-banner-5.png',
	},
];

---

<SiteLayout current="home">
	<section class="relative aspect-[2048/768] max-h-[560px] w-full overflow-hidden bg-neutral-950 text-white" aria-label="首页轮播图">
		<div class="absolute inset-0" data-hero-carousel>
			{heroSlides.map((slide, index) => (
				<div
					class:list={[
						'absolute inset-0 flex items-center justify-center px-5 text-center transition-opacity duration-700 sm:px-8',
						index === 0 ? 'opacity-100' : 'opacity-0',
					]}
					data-hero-slide
					aria-hidden={index === 0 ? 'false' : 'true'}
				>
					{slide.image ? (
						<img
							src={slide.image}
							alt={slide.desc}
							class="absolute inset-0 h-full w-full object-contain"
							width="2048"
							height="768"
						/>
					) : (
						<>
							<div class="absolute inset-0 bg-[linear-gradient(115deg,#09090b_0%,#18181b_48%,#e30613_48%,#e30613_100%)]"></div>
							<div class="relative flex h-[72%] w-full max-w-6xl items-center justify-center border border-white/15 bg-white/[0.06]">
								<div class="absolute inset-3 border border-dashed border-white/20 sm:inset-5"></div>
								<div>
									<p class="text-xs font-black uppercase tracking-normal text-white/60 sm:text-sm">Placeholder Image</p>
									<h1 class="mt-2 text-3xl font-black tracking-normal sm:mt-4 sm:text-5xl lg:text-6xl">{slide.title}</h1>
									<p class="mt-2 text-sm font-semibold text-white/75 sm:mt-4 sm:text-lg">{slide.desc}</p>
								</div>
							</div>
						</>
					)}
				</div>
			))}
		</div>
		<div class="absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-2 sm:bottom-6" aria-label="轮播分页">
			{heroSlides.map((_, index) => (
				<button
					type="button"
					class:list={[
						'h-2 w-6 transition sm:h-2.5 sm:w-8',
						index === 0 ? 'bg-white' : 'bg-white/35 hover:bg-white/70',
					]}
					data-hero-dot
					aria-label={`切换到第 ${index + 1} 张`}
					aria-current={index === 0 ? 'true' : 'false'}
				></button>
			))}
		</div>
	</section>

	<section class="bg-white py-12">
		<div class="mx-auto grid max-w-7xl grid-cols-4 gap-px bg-neutral-200 px-3 sm:px-8">
			{categories.map(([title, meta, desc]) => (
				<a href="/products/" class="group bg-white px-2 py-3 transition hover:bg-[#e30613] sm:p-6">
					<p class="text-[10px] font-black uppercase leading-tight text-[#e30613] transition group-hover:text-neutral-950 sm:text-sm">{meta}</p>
					<h2 class="mt-1.5 text-base font-black leading-tight text-neutral-950 transition group-hover:text-white sm:mt-3 sm:text-2xl">{title}</h2>
					<p class="mt-1.5 text-[11px] leading-snug text-neutral-600 transition group-hover:text-white sm:mt-3 sm:text-base sm:leading-7">{desc}</p>
				</a>
			))}
		</div>
	</section>

	<section class="bg-neutral-100 py-20 sm:py-24">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-center">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">Product System</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">
					以荷兰进口润滑油带动产品矩阵
				</h2>
				<p class="mt-5 text-lg leading-8 text-neutral-600">
					力耐以全系列荷兰原罐原装润滑油为产品核心主线，并涵盖特种工业润滑产品、多功能养护气雾剂、全场景清洁剂、轨道交通专用养护品、全套汽车美容产品以及专业维修胶粘剂。全面满足汽车后市场与专业工业设备运维需求。
				</p>
				<a
					href="/products/"
					class="mt-8 inline-flex min-h-12 items-center justify-center bg-[#e30613] px-6 text-base font-black text-white transition hover:bg-[#c9000b]"
				>
					进入产品中心
				</a>
			</div>
			<div class="overflow-hidden bg-white p-6 shadow-sm">
				<img
					src="/images/lionax-family-hero.png"
					alt="lionax 产品组合"
					class="mx-auto max-h-[380px] w-full scale-[2] object-contain"
					width="1055"
					height="1491"
				/>
			</div>
		</div>
	</section>

	<section class="bg-white pb-8 pt-16 sm:pb-10 sm:pt-20">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mb-8 max-w-7xl">
				<p class="text-sm font-black uppercase text-[#e30613]">Made in Netherlands</p>
				<h2 class="mt-3 text-3xl font-black tracking-normal text-neutral-950 sm:text-4xl">
					润滑油全系列荷兰原罐原装
				</h2>
				<p class="mt-4 text-lg leading-8 text-neutral-600">
					以欧洲标准和原罐原装体系支撑核心润滑油产品，为渠道和终端车主提供稳定、可信的产品基础。
				</p>
			</div>
			<img
				src="/images/lionax-carousel-netherlands.png"
				alt="lionax 荷兰原罐原装说明图"
				class="w-full object-contain"
				width="2048"
				height="768"
			/>
		</div>
	</section>

	<script>
		const carousel = document.querySelector('[data-hero-carousel]');
		const slides = Array.from(document.querySelectorAll('[data-hero-slide]'));
		const dots = Array.from(document.querySelectorAll('[data-hero-dot]'));
		let activeSlide = 0;
		let slideTimer;

		function showSlide(nextIndex) {
			activeSlide = (nextIndex + slides.length) % slides.length;

			slides.forEach((slide, index) => {
				const isActive = index === activeSlide;
				slide.classList.toggle('opacity-100', isActive);
				slide.classList.toggle('opacity-0', !isActive);
				slide.setAttribute('aria-hidden', String(!isActive));
			});

			dots.forEach((dot, index) => {
				const isActive = index === activeSlide;
				dot.classList.toggle('bg-white', isActive);
				dot.classList.toggle('bg-white/35', !isActive);
				dot.setAttribute('aria-current', String(isActive));
			});
		}

		function startSlides() {
			window.clearInterval(slideTimer);
			slideTimer = window.setInterval(() => showSlide(activeSlide + 1), 4200);
		}

		dots.forEach((dot, index) => {
			dot.addEventListener('click', () => {
				showSlide(index);
				startSlides();
			});
		});

		if (carousel && slides.length > 1) {
			startSlides();
		}
	</script>

	<section class="bg-[#e30613] py-14 text-white">
		<div class="mx-auto flex max-w-7xl flex-col justify-between gap-6 px-5 sm:px-8 lg:flex-row lg:items-center">
			<div>
				<p class="text-sm font-black uppercase text-white/75">Cooperation</p>
				<h2 class="mt-2 text-3xl font-black tracking-normal sm:text-4xl">建立 LIONAX 产品渠道合作</h2>
			</div>
			<a
				href="/cooperation/"
				class="inline-flex min-h-12 items-center justify-center bg-white px-6 text-base font-black text-[#e30613] transition hover:bg-neutral-100"
			>
				查看合作方式
			</a>
		</div>
	</section>
</SiteLayout>
