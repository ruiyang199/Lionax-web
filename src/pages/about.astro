---
import SiteLayout from '../layouts/SiteLayout.astro';

const strengths = [
	['全球优势集成者', '整合世界优秀产品与本地渠道服务，为中国车主带来更高品质的养护体验。'],
	['荷兰原罐原装', '力耐润滑油全系列从荷兰原罐原装，甄选先进、严苛标准的欧洲产品。'],
	['渠道覆盖', '全国销售渠道持续扩展，服务超过 500 万车主重复使用。'],
	['长期服务', '为合作方提供技术、培训、销售工具和库存管理支持。'],
];

const commitments = [
	'让世界优秀产品，更好为中国车主服务。',
	'润滑油全系列从荷兰原罐原装，按严苛标准引进。',
	'以品质为核心，持续提升品牌价值与服务能力。',
];
---

<SiteLayout
	current="about"
	title="关于 | lionax 汽车润滑油与养护用品"
	description="了解广州力耐国际贸易有限公司、力耐 LIONAX 品牌理念、全国销售渠道和合作服务支持。"
>
	<section class="bg-white py-12 sm:py-16">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.88fr_1.12fr] lg:items-center">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">About lionax</p>
				<h1 class="mt-3 text-5xl font-black leading-tight tracking-normal text-neutral-950 sm:text-6xl">
					关于
				</h1>
				<p class="mt-6 text-xl leading-8 text-neutral-700">
					广州力耐国际贸易有限公司是力耐 LIONAX 品牌运营商，也是汽车润滑油、养护品进口商。
				</p>
				<p class="mt-5 text-lg leading-8 text-neutral-600">
					公司以“让世界优秀产品，更好为中国车主服务”为己任，力耐润滑油全系列从荷兰原罐原装，甄选先进、标准严苛的欧洲产品，只为提供更好的驾乘体验。
				</p>
			</div>
			<div class="bg-neutral-50 p-8">
				<img
					src="/images/lionax-logo.png"
					alt="lionax 红色品牌 logo"
					class="mx-auto max-h-80 object-contain"
					width="1060"
					height="1484"
				/>
			</div>
		</div>
	</section>

	<section class="bg-neutral-100 py-12 sm:py-16">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="mb-8 max-w-3xl">
				<p class="text-sm font-black uppercase text-[#e30613]">Our Team</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">我们的团队</h2>
			</div>
			<div class="grid gap-5 lg:grid-cols-2">
				<figure class="bg-white p-4 shadow-sm">
					<img
						src="/images/lionax-team-football.png"
						alt="力耐团队足球活动合影"
						class="aspect-[29/18] w-full object-cover"
						width="580"
						height="360"
					/>
				</figure>
				<figure class="bg-white p-4 shadow-sm">
					<img
						src="/images/lionax-team-event.png"
						alt="力耐团队活动合影"
						class="aspect-[29/18] w-full object-cover"
						width="580"
						height="360"
					/>
				</figure>
			</div>
		</div>
	</section>

	<section class="bg-neutral-950 py-12 text-white sm:py-16">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">For Better Performance</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal sm:text-5xl">为更好表现</h2>
				<div class="mt-7 space-y-5 text-lg leading-8 text-neutral-300">
					<p>
						一直以来，力耐都将“追求更好”奉为品牌目标，精品精神已深入骨髓。公司寻求世界领先技术，与欧洲顶尖制造商深度合作，紧随不断升级的汽车制造工艺。
					</p>
					<p>
						力耐严格按照汽车制造厂商要求，开发贴合市场的先进产品。其中润滑油全系列从荷兰原罐原装，使核心产品务必达到国际高等级的使用与检验标准，并有所超越。
					</p>
					<p>
						如今，力耐以品质为核心，不断锐意进取、深耕服务，其版图正在快速扩大，全国超过 500 万车主已在重复使用力耐产品。
					</p>
				</div>
			</div>
			<div class="bg-white p-5">
				<img
					src="/images/lionax-distribution-map-new.png"
					alt="力耐销售渠道分布地图"
					class="w-full object-contain"
					width="1398"
					height="1518"
				/>
			</div>
		</div>
	</section>

	<section class="bg-white py-12 sm:py-16">
		<div class="mx-auto grid max-w-7xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.8fr_1.2fr]">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">Brand Mission</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">品牌使命</h2>
			</div>
			<div class="grid gap-4">
				{commitments.map((item) => (
					<div class="border-l-4 border-[#e30613] bg-neutral-50 p-6 text-xl font-black leading-8 text-neutral-950">
						{item}
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-neutral-100 py-12 sm:py-16">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{strengths.map(([title, body]) => (
					<div class="border border-neutral-200 bg-white p-6 shadow-sm">
						<h2 class="text-xl font-black text-[#e30613]">{title}</h2>
						<p class="mt-3 text-sm leading-6 text-neutral-600">{body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-white py-12 sm:py-16">
		<div class="mx-auto max-w-5xl px-5 sm:px-8">
			<p class="text-sm font-black uppercase text-[#e30613]">Partner Support</p>
			<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">与合作方共同成长</h2>
			<div class="mt-8 space-y-5 text-lg leading-9 text-neutral-700">
				<p>
					力耐国际秉承力耐 LIONAX 品牌理念，为合作方提供优质的力耐 LIONAX 全系列产品，同时与合作方并肩工作，一起寻找与改进生产中所遇到的问题。
				</p>
				<p>
					公司设立专业部门和技术人员负责售后服务事宜，以一丝不苟的工作作风，为合作方及时提供技术支持与培训，并随时保持技术信息交流。
				</p>
				<p>
					力耐也为合作者提供有效的销售工具支持和库存管理支持，以节约成本、简化手续，形成长期良性发展，实现利润最大化，达到双赢，并最终让消费者满意。
				</p>
				<p>
					未来，力耐国际将一如既往履行对客户的承诺，并继续深化与客户的合作伙伴关系，不断为客户需求寻找革新的解决方案。
				</p>
			</div>
		</div>
	</section>
</SiteLayout>
