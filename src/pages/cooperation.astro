---
import SiteLayout from '../layouts/SiteLayout.astro';

const serviceItems = [
	{
		title: '门店陈列',
		desc: '品牌形象进店上墙，产品整齐陈列，让终端门店更有识别度。',
		image: '/images/lionax-store-display.webp',
		alt: 'lionax 门店陈列照片',
	},
	{
		title: '施工场景',
		desc: '从开瓶到加注，每一次标准施工，都是对车辆表现的认真守护。',
		image: '/images/lionax-service-scene.webp',
		alt: 'lionax 换油施工场景照片',
	},
	{
		title: '赛事赞助',
		desc: '走进真实赛场，以高强度赛事场景验证产品表现，持续强化 LIONAX 动力运动品牌声量。',
		image: '/images/lionax-racing-sponsorship.webp',
		alt: 'lionax 赛事赞助现场照片',
	},
];

const siteUrl = Astro.site ?? new URL('https://l-lionax.com');
const structuredData = {
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: '力耐官网',
			item: siteUrl.href,
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: '渠道合作',
			item: new URL('/cooperation/', siteUrl).href,
		},
	],
};

---

<SiteLayout
	current="cooperation"
	title="力耐机油代理与渠道合作 | LIONAX 经销支持"
	description="力耐 LIONAX 面向经销商、汽修门店、洗美门店和动力运动养护渠道提供机油产品资料、授权体系、技术培训与合作支持。"
	keywords={['力耐机油代理', '力耐经销商', 'LIONAX 合作', '机油渠道合作', '汽车养护品代理']}
	pageSchemaType="ContactPage"
	structuredData={structuredData}
>
	<section class="bg-white py-16">
		<div class="mx-auto max-w-5xl px-5 sm:px-8">
			<h1 class="sr-only">力耐 LIONAX 机油代理与渠道合作</h1>
			<p class="text-sm font-black uppercase text-[#e30613]">Partner Support</p>
			<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">与合作方共成长</h2>
			<div class="mt-8 space-y-5 text-lg leading-9 text-neutral-700">
				<p>
					力耐国际秉承力耐 LIONAX 品牌理念，为合作方提供优质的力耐 LIONAX 全系列产品，同时与合作方并肩工作，一起寻找与改进生产中所遇到的问题。
				</p>
				<p>
					公司设立专业部门和技术人员负责售后服务事宜，以一丝不苟的工作作风，为合作方及时提供技术支持与培训，并随时保持技术信息交流。
				</p>
				<p>
					力耐也为合作者提供有效的销售工具支持和库存管理支持，以节约成本、简化手续，形成长期良性发展，实现利润最大化，达到双赢，并最终让消费者满意。
				</p>
				<p>
					未来，力耐国际将一如既往履行对客户的承诺，并继续深化与客户的合作伙伴关系，不断为客户需求寻找革新的解决方案。
				</p>
			</div>
			<img
				src="/images/lionax-cooperation-partner-support.webp"
				alt="LIONAX 合作伙伴支持场景"
				class="mt-8 aspect-[16/7] w-full object-cover"
				width="1905"
				height="828"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</section>

	<section class="bg-neutral-100 py-16">
		<div class="mx-auto grid max-w-5xl gap-8 px-5 sm:px-8 lg:grid-cols-[0.75fr_1.25fr] lg:items-start">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">Authorization System</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal text-neutral-950 sm:text-5xl">严控授权体系</h2>
			</div>
			<div class="border-l-4 border-[#e30613] bg-white p-7 text-lg leading-9 text-neutral-700 sm:p-9">
				<p>
					力耐坚持小众高端、控量保质、长期共赢的核心发展路线，全国严格推行限量授权体系，实现优胜劣汰机制，严控区域门店密度，全面保障合作伙伴专属区域特权与稳定利益。
				</p>
			</div>
			<img
				src="/images/lionax-authorization-system.webp"
				alt="LIONAX 严控授权体系"
				class="lg:col-span-2 aspect-[16/7] w-full object-cover"
				width="1896"
				height="829"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</section>

	<section class="bg-neutral-950 py-20 text-white sm:py-24">
		<div class="mx-auto grid max-w-5xl gap-10 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr]">
			<div>
				<p class="text-sm font-black uppercase text-[#e30613]">Service & Display</p>
				<h2 class="mt-3 text-4xl font-black tracking-normal sm:text-5xl">终端场景与服务支持</h2>
				<p class="mt-5 text-lg leading-8 text-neutral-300">
					从门店陈列到现场施工，LIONAX 将产品力、品牌形象和终端服务连接起来，让每一次养护都有清晰可见的专业感。
				</p>
			</div>
			<div class="grid gap-4 sm:grid-cols-3">
				{serviceItems.map((item) => (
					<div class="border border-white/10 bg-white/[0.06] p-5">
						<div class="flex aspect-square items-center justify-center overflow-hidden border border-solid border-white/20 bg-white/[0.04] text-xs font-black uppercase text-white/35">
							<img
								src={item.image}
								alt={item.alt}
								class="h-full w-full object-cover"
								width="1080"
								height="1440"
								loading="lazy"
								decoding="async"
							/>
						</div>
						<h3 class="mt-5 text-xl font-black">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-neutral-300">{item.desc}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<section class="bg-white py-16">
		<div class="mx-auto max-w-7xl px-5 sm:px-8">
			<div class="grid gap-8 bg-[#e30613] p-7 text-white sm:p-10 lg:grid-cols-[1fr_0.9fr] lg:items-center">
				<div>
					<p class="text-sm font-black uppercase text-white/80">Start with lionax</p>
					<h2 class="mt-2 text-3xl font-black tracking-normal sm:text-4xl">获取 LIONAX 合作资料</h2>
					<p class="mt-4 max-w-2xl leading-7 text-white/85">
						欢迎经销商、汽修门店、洗美门店和 Powersports 养护渠道咨询产品资料与合作政策。
					</p>
				</div>
				<div class="bg-white p-5 text-[#e30613] sm:p-6">
					<p class="text-lg font-black text-neutral-950">广州力耐国际贸易有限公司</p>
					<div class="mt-4 grid gap-3 text-sm font-bold leading-6 sm:text-base">
						<a href="mailto:gzlionax@126.com" class="transition hover:text-[#e30613]">公司邮箱: gzlionax@126.com</a>
						<a href="tel:13622877018" class="transition hover:text-[#e30613]">联系方式: 13622877018</a>
						<p class="text-neutral-700">联系地址: 广州市番禺区番禺大道北555号天安科技园创新大厦602室</p>
					</div>
					<div class="mt-5 grid grid-cols-2 gap-4 text-center text-xs font-black text-neutral-700">
						<div>
							<img
								src="/images/lionax-qr-jd.jpg"
								alt="力耐京东二维码"
								class="mx-auto aspect-square w-full max-w-36 object-contain"
								width="707"
								height="711"
								loading="lazy"
								decoding="async"
							/>
							<p class="mt-2">京东旗舰店</p>
						</div>
						<div>
							<img
								src="/images/lionax-qr-contact.png"
								alt="力耐联系二维码"
								class="mx-auto aspect-square w-full max-w-36 object-contain"
								width="200"
								height="200"
								loading="lazy"
								decoding="async"
							/>
							<p class="mt-2">扫码联系</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</SiteLayout>
