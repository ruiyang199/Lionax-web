---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	current?: 'home' | 'products' | 'about' | 'cooperation';
	canonicalPath?: string;
	image?: string;
	imageAlt?: string;
	imageWidth?: number;
	imageHeight?: number;
	openGraphType?: 'website' | 'article' | 'product';
	pageSchemaType?: string | string[];
	keywords?: string[];
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title = '力耐机油官网 | LIONAX 荷兰原装润滑油与汽车养护用品',
	description = '力耐（LIONAX）机油官网，提供荷兰原罐原装汽车机油、摩托车机油、动力运动润滑油，以及汽车养护品、汽美产品和维修耗材。',
	current,
	canonicalPath,
	image = '/og.png',
	imageAlt = '力耐 LIONAX 荷兰原装润滑油与汽车养护用品',
	imageWidth,
	imageHeight,
	openGraphType = 'website',
	pageSchemaType = 'WebPage',
	keywords = ['力耐机油', '力耐', 'LIONAX', '荷兰原装机油', '汽车润滑油', '摩托车机油'],
	noindex = false,
	structuredData = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL('https://l-lionax.com');
const canonicalUrl = new URL(canonicalPath ?? Astro.url.pathname, siteUrl);
canonicalUrl.search = '';
canonicalUrl.hash = '';

const canonical = canonicalUrl.href;
const socialImage = new URL(image, siteUrl).href;
const socialImageWidth = imageWidth ?? (image === '/og.png' ? 1200 : undefined);
const socialImageHeight = imageHeight ?? (image === '/og.png' ? 630 : undefined);
const extraStructuredData = Array.isArray(structuredData) ? structuredData : [structuredData];
const graph = noindex
	? []
	: [
		{
			'@type': 'Organization',
			'@id': `${siteUrl.href}#organization`,
			name: '广州力耐国际贸易有限公司',
			alternateName: ['力耐', 'LIONAX'],
			url: siteUrl.href,
			logo: new URL('/images/lionax-logo.png', siteUrl).href,
			email: 'gzlionax@126.com',
			telephone: '+86-136-2287-7018',
			address: {
				'@type': 'PostalAddress',
				streetAddress: '番禺大道北555号天安科技园创新大厦602室',
				addressLocality: '广州市',
				addressRegion: '广东省',
				addressCountry: 'CN',
			},
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'sales',
				telephone: '+86-136-2287-7018',
				email: 'gzlionax@126.com',
				availableLanguage: ['zh-CN'],
			},
		},
		{
			'@type': 'WebSite',
			'@id': `${siteUrl.href}#website`,
			url: siteUrl.href,
			name: '力耐 LIONAX 官网',
			alternateName: '力耐机油官网',
			inLanguage: 'zh-CN',
			publisher: { '@id': `${siteUrl.href}#organization` },
		},
		{
			'@type': pageSchemaType,
			'@id': `${canonical}#webpage`,
			url: canonical,
			name: title,
			description,
			inLanguage: 'zh-CN',
			isPartOf: { '@id': `${siteUrl.href}#website` },
			about: { '@id': `${siteUrl.href}#organization` },
			primaryImageOfPage: {
				'@type': 'ImageObject',
				url: socialImage,
			},
		},
		...extraStructuredData,
	];

const schema = {
	'@context': 'https://schema.org',
	'@graph': graph,
};

const navItems = [
	{ key: 'home', label: '首页', href: '/' },
	{ key: 'about', label: '关于', href: '/about/' },
	{ key: 'products', label: '产品', href: '/products/' },
	{ key: 'cooperation', label: '合作', href: '/cooperation/' },
];
---

<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords.join(', ')} />
		<meta
			name="robots"
			content={noindex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'}
		/>
		<meta name="theme-color" content="#e30613" />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:site_name" content="力耐 LIONAX 官网" />
		<meta property="og:type" content={openGraphType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={socialImage} />
		{socialImageWidth && <meta property="og:image:width" content={String(socialImageWidth)} />}
		{socialImageHeight && <meta property="og:image:height" content={String(socialImageHeight)} />}
		<meta property="og:image:alt" content={imageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={socialImage} />
		<meta name="twitter:image:alt" content={imageAlt} />
		<title>{title}</title>
		{!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
	</head>
	<body class="bg-white text-neutral-950 antialiased">
		<header class="sticky top-0 z-40 border-b border-neutral-200 bg-white/95 backdrop-blur">
			<nav class="mx-auto flex max-w-7xl items-center justify-between px-5 py-4 sm:px-8">
				<a href="/" class="flex items-center gap-3" aria-label="lionax 首页">
					<img
						src="/images/lionax-logo.png"
							alt="LIONAX"
							class="h-12 w-auto object-contain"
							width="570"
							height="600"
						/>
				</a>
				<div class="hidden items-center gap-8 text-lg font-black text-neutral-950 md:flex">
					{navItems.map((item) => (
						<a
							class:list={[
								'transition hover:text-[#e30613]',
								current === item.key && 'text-[#e30613]',
							]}
							href={item.href}
						>
							{item.label}
						</a>
					))}
				</div>
				<a
					href="/cooperation/"
					class="inline-flex min-h-10 items-center justify-center bg-[#e30613] px-4 text-xs font-black text-white transition hover:bg-[#c9000b] sm:min-h-11 sm:px-5 sm:text-sm"
				>
					获取合作方案
				</a>
			</nav>
			<nav class="mx-auto flex max-w-7xl items-center justify-center gap-6 overflow-x-auto border-t border-neutral-100 px-5 py-3 text-lg font-black text-neutral-950 sm:px-8 md:hidden" aria-label="移动端导航">
				{navItems.map((item) => (
					<a
						class:list={[
							'shrink-0 transition hover:text-[#e30613]',
							current === item.key && 'text-[#e30613]',
						]}
						href={item.href}
					>
						{item.label}
					</a>
				))}
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="border-t border-neutral-200 bg-white px-5 py-8 text-sm text-neutral-500 sm:px-8">
			<div class="mx-auto flex max-w-7xl flex-col justify-between gap-4 lg:flex-row lg:items-end">
				<div>
					<p class="font-black text-neutral-800">广州力耐国际贸易有限公司</p>
					<div class="mt-3 grid gap-1 leading-6 sm:grid-cols-2 lg:grid-cols-none">
						<a href="mailto:gzlionax@126.com" class="transition hover:text-[#e30613]">公司邮箱: gzlionax@126.com</a>
						<a href="tel:13622877018" class="transition hover:text-[#e30613]">联系方式: 13622877018</a>
						<p class="sm:col-span-2 lg:col-span-1">联系地址: 广州市番禺区番禺大道北555号天安科技园创新大厦602室</p>
					</div>
				</div>
				<div class="grid gap-4 sm:grid-cols-[auto_1fr] sm:items-end lg:grid-cols-1 lg:justify-items-end">
					<div class="flex gap-4">
						<div class="text-center text-xs font-black text-neutral-600">
							<img
								src="/images/lionax-qr-jd.jpg"
								alt="力耐京东二维码"
							class="mx-auto aspect-square w-20 object-contain"
							width="707"
							height="711"
							loading="lazy"
							decoding="async"
							/>
							<p class="mt-1">京东旗舰店</p>
						</div>
						<div class="text-center text-xs font-black text-neutral-600">
							<img
								src="/images/lionax-qr-contact.png"
								alt="力耐联系二维码"
							class="mx-auto aspect-square w-20 object-contain"
							width="200"
							height="200"
							loading="lazy"
							decoding="async"
							/>
							<p class="mt-1">扫码联系</p>
						</div>
					</div>
					<p class="leading-6 sm:text-right">
						力耐官网 版权所有
						<a href="https://beian.miit.gov.cn/" class="font-semibold text-neutral-600 transition hover:text-[#e30613]" target="_blank" rel="noreferrer">
							© 2001-2026 粤ICP备09198580号
						</a>
					</p>
				</div>
			</div>
		</footer>
	</body>
</html>
